math <- "core:math"
io <- "core:io"

\\ struct syntax similar to Go's
Vector <- struct {
  float x,
  float y
}

\\ method Syntax inspired by go
print <- (Vector *v) proc() {
  io.println("X: {x}, Y: {y}")
}

\\ function, forced by the compiler to not run any other functions but not procedures
\\ also can't be a pointer for struct methods
length <- (Vector v) func() float {
  return math.sqrt(math.square(v.x), math.square(v.y))
}

main <- proc() {
  \\ statically typed
  \\ with the := syntax ONLY 
  \\ setting variables with =
  \\ also inspired by go
  \\ new syntax could possibly leave
  test: Vector = new(4, 3);

  \\ accessing struct methods using . syntax
  \\ could change
  test.print();

  io.println(test.length()); 
}